# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=qyglfb

# ===== 安全配置 =====
# JWT 签名密钥（生产必须配置强随机值，可用 openssl rand -hex 64 生成）
JWT_SECRET=please_change_me_to_a_long_random_secret
# JWT 密钥轮换（可选）：轮换时把旧密钥放这里，使轮换前已签发的 token 仍有效（无感轮换）
# JWT_SECRET_PREVIOUS=

# ===== 安全告警通知（可选）=====
# 高危安全事件（登录爆破、新IP登录、停用账号等）推送通知
#
# 方式1：企业微信/钉钉机器人（自动识别，不配置则不推送）
# ALERT_WEBHOOK_TYPE=wecom  # 可选 wecom / dingtalk，不填则按 URL 自动识别
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key
#
# 方式2：邮箱通知（SMTP，推荐）。需邮箱授权码（QQ/163/Gmail 等）
# MAIL_HOST=smtp.qq.com       # SMTP服务器（qq=smtp.qq.com, 163=smtp.163.com, gmail=smtp.gmail.com）
# MAIL_PORT=465               # 465=SSL(推荐) / 587=STARTTLS
# MAIL_SECURE=true            # true=SSL
# MAIL_USER=you@qq.com        # 发件邮箱
# MAIL_PASS=授权码             # 邮箱授权码（非登录密码）
# MAIL_TO=admin@qq.com        # 告警收件人（多个用英文逗号分隔）
# MAIL_FROM=智慧办公平台安全告警 # 发件人显示名（可选）

# ===== 备份异地存储（可选）=====
# 自动备份生成后，复制到另一台电脑的共享目录（Windows UNC 路径或本地路径）
# 留空则不执行异地备份。示例：\\192.168.2.100\backup
# 注意：需确保本机对该共享目录有写入权限
# BACKUP_REMOTE_PATH=

# ===== 日志维护（可选）=====
# 操作日志保留天数（scripts/cleanup-logs.js 使用，默认 180 天）
# LOG_RETENTION_DAYS=180
# 日志归档保留份数（默认 10 份，超过则清理旧归档）
# LOG_KEEP=10

# ===== 备份加密（可选）=====
# 自动备份生成后用 AES-256 加密（生成 .enc 文件），异地备份复制加密后的文件
# 密钥为 32 字节 hex（64 位十六进制），可用 openssl rand -hex 32 生成
# ⚠️ 密钥必须妥善保管，一旦丢失将无法解密备份！
# 留空则不加密（保留明文 SQL 备份）
# BACKUP_ENCRYPT_KEY=
# 管理员初始密码（仅首次创建管理员账号时生效，建议配置后修改）
ADMIN_INIT_PASSWORD=Admin@2026
# 员工初始密码（可选：不配置则系统为每个新员工自动生成唯一随机强密码）
EMPLOYEE_INIT_PASSWORD=

# ===== 前端跨域白名单（CORS）=====
# 重要：此配置决定哪些来源可以访问后端 API。
# 多环境部署时，请把服务器/内网访问地址加进来（逗号分隔），例如：
#   CORS_ORIGINS=http://localhost:3003,http://localhost:8080,http://192.168.2.142:8080
CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003,http://localhost:8080,http://127.0.0.1:8080
