# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=qyglfb

# ===== 安全配置 =====
# JWT 签名密钥（生产必须配置强随机值，可用 openssl rand -hex 64 生成）
JWT_SECRET=please_change_me_to_a_long_random_secret
# 管理员初始密码（仅首次创建管理员账号时生效，建议配置后修改）
ADMIN_INIT_PASSWORD=Admin@2026
# 员工初始密码（可选：不配置则系统为每个新员工自动生成唯一随机强密码）
EMPLOYEE_INIT_PASSWORD=

# ===== 前端跨域白名单（CORS）=====
# 重要：此配置决定哪些来源可以访问后端 API。
# 多环境部署时，请把服务器/内网访问地址加进来（逗号分隔），例如：
#   CORS_ORIGINS=http://localhost:3003,http://localhost:8080,http://192.168.2.142:8080
CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003,http://localhost:8080,http://127.0.0.1:8080
